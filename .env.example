# Storefront — copy to .env (do not commit .env)

# Public site URL, no trailing slash (canonical, OG, sitemap base).
VITE_APP_URL=https://inovative-hub.com

# Backend API base, no trailing slash. Leave empty in local dev to use Vite /api proxy.
VITE_API_URL=

# Optional: OAuth, payments
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=

# Optional: `npm run build` sitemap fetch — if API URL for Node differs from VITE_API_URL (e.g. CI).
# SITEMAP_API_URL=https://api.your-domain.com
